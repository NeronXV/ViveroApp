# Local development ONLY. Copy to .env; replace both database placeholders.
# Generate each value independently: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MARIADB_ROOT_PASSWORD=replace-with-random-root-password
MARIADB_PASSWORD=replace-with-random-api-db-password
API_PORT=3001
# Exact browser origin when using the Vite/reverse proxy; no trailing slash.
# WEB_ORIGIN=http://localhost:5173
# Optional recovery/invitations; server only. Configure a verified sender.
# RESEND_API_KEY=replace-with-private-resend-key
# ACCOUNT_MAIL_FROM=Vivero Dulcinea <acceso@example.invalid>
# NEWSLETTER_FROM=Vivero Dulcinea <boletin@example.invalid>
# NEWSLETTER_LINK_KEY=replace-with-64-lowercase-hex-characters
# Keep this independent random key with encrypted backups; do not rotate in place.
# No VITE_* secrets. Catalog writes now require a user session, not a shared token.
# Optional, only passed to the one-time bootstrap service, never the API:
# BOOTSTRAP_EMAIL=owner@example.invalid
# BOOTSTRAP_FULL_NAME=Propietario local
# BOOTSTRAP_BRANCH_CODE=DEMO
# BOOTSTRAP_PASSWORD=replace-with-a-unique-password-at-least-15-characters

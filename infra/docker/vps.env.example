# Private configuration: copy outside Git. Use independent random passwords.
MARIADB_ROOT_PASSWORD=replace-with-random-root-password
MARIADB_PASSWORD=replace-with-random-api-db-password
VIVERO_DOMAIN=vivero.example.invalid
# Optional domain transition: exact origins only; never use wildcards.
# VIVERO_LEGACY_DOMAIN=previous.example.invalid
# WEB_ORIGIN_ALIASES=https://previous.example.invalid
# Configure recovery/invitations after verifying the sending domain.
# RESEND_API_KEY=replace-with-private-resend-key
# ACCOUNT_MAIL_FROM=Vivero Dulcinea <acceso@example.invalid>
# NEWSLETTER_FROM=Vivero Dulcinea <boletin@example.invalid>
# NEWSLETTER_LINK_KEY=replace-with-64-lowercase-hex-characters
# Preserve the independent encryption key outside Git with encrypted backups.
# No Supabase keys, database port exposure or VITE secrets.
